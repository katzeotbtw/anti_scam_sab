----------------------------
-- Draggable UI
----------------------------
do
	local dragging, dragStart, startPos
	frame.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = i.Position
			startPos = frame.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

----------------------------
-- CashPad SAFE (ignore while collecting)
----------------------------
for _, obj in ipairs(workspace:GetDescendants()) do
	if obj:IsA("BasePart") and obj.Name == CASH_PAD_NAME then
		obj.Touched:Connect(function(hit)
			local char = hit:FindFirstAncestorOfClass("Model")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				local plr = Players:GetPlayerFromCharacter(char)
				if plr then collectingPlayers[plr.UserId] = true end
			end
		end)
		obj.TouchEnded:Connect(function(hit)
			local char = hit:FindFirstAncestorOfClass("Model")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				local plr = Players:GetPlayerFromCharacter(char)
				if plr then collectingPlayers[plr.UserId] = nil end
			end
		end)
	end
end

----------------------------
-- Helpers
----------------------------
local function getHRP(plr)
	return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

local function isInPlotXZ(pos, plot)
	local cf, size = plot:GetBoundingBox()
	local rel = cf:PointToObjectSpace(pos)
	return math.abs(rel.X) <= size.X/2 and math.abs(rel.Z) <= size.Z/2
end

local function findMyPlot()
	local hrp = getHRP(player)
	if not hrp then return nil end
	local closest, dist = nil, math.huge
	for _, plot in ipairs(PLOTS:GetChildren()) do
		local cf = plot:GetBoundingBox()
		local d = (cf.Position - hrp.Position).Magnitude
		if d < dist then
			dist = d
			closest = plot
		end
	end
	return closest
end

----------------------------
-- Detection Loop (OBFUSCATOR-SAFE)
----------------------------
RunService.Heartbeat:Connect(function(dt)
	if not enabledValue.Value or not myPlot then return end
	if (tick() - enableTimeValue.Value) < GRACE_PERIOD then return end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			if collectingPlayers[other.UserId] then
				insideTime[other.UserId] = 0
				continue
			end

			local hrp = getHRP(other)
			if hrp then
				if isInPlotXZ(hrp.Position, myPlot) then
					insideTime[other.UserId] = (insideTime[other.UserId] or 0) + dt
				else
					insideTime[other.UserId] = 0
				end

				if insideTime[other.UserId] >= CONFIRM_TIME then
					player:Kick("Anti-Scam: Intruder detected inside your base.")
					return
				end
			end
		end
	end
end)

