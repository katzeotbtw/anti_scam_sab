------------------------------------------------
-- ANTI-SCAM LOOP
------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	if not antiEnabled or not myPlot then return end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local hrp = getHRP(other)
			if hrp and isInPlot(hrp.Position, myPlot) then
				insideTime[other.UserId] = (insideTime[other.UserId] or 0) + dt
				if insideTime[other.UserId] >= CONFIRM_TIME then
					player:Kick("Anti-Scam: Player detected inside your base.")
					return
				end
			else
				insideTime[other.UserId] = 0
			end
		end
	end
end)
