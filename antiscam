------------------------------------------------
-- HELPERS
------------------------------------------------
local function getHRP(plr)
	return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

local function isInPlot(pos, plot)
	local cf, size = plot:GetBoundingBox()
	local rel = cf:PointToObjectSpace(pos)
	return math.abs(rel.X) <= size.X/2 and math.abs(rel.Z) <= size.Z/2
end

local function findMyPlot()
	local hrp = getHRP(player)
	if not hrp then return nil end
	local best, dist = nil, math.huge
	for _, plot in ipairs(PLOTS:GetChildren()) do
		local cf = plot:GetBoundingBox()
		local d = (cf.Position - hrp.Position).Magnitude
		if d < dist then dist = d; best = plot end
	end
	return best
end

